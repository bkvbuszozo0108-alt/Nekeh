rules_version = '2';

// NEKEH Portál – Firestore biztonsági szabályok
// Másold be teljes egészében: Firebase Console → Firestore Database → Rules → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerExists() { return exists(/databases/$(database)/documents/meta/owner); }
    function isOwner() {
      return signedIn() && ownerExists()
        && get(/databases/$(database)/documents/meta/owner).data.uid == request.auth.uid;
    }
    function hasRole() { return signedIn() && exists(/databases/$(database)/documents/roles/$(request.auth.uid)); }
    function role() { return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data; }
    function isMember() { return isOwner() || hasRole(); }
    function isLeader() { return isOwner() || (hasRole() && role().level >= 50); }
    function unitIs(u) { return hasRole() && role().unit == u; }
    function atLeast(n) { return isOwner() || (hasRole() && role().level >= n); }
    // A Roblox-játékszerver saját szolgálati fiókja (Vezetés → Roblox-játék összekapcsolása)
    function isGame() {
      return signedIn() && exists(/databases/$(database)/documents/meta/game)
        && get(/databases/$(database)/documents/meta/game).data.uid == request.auth.uid;
    }

    function canSee(ch) {
      return isMember() && (
        ch in ['kozlemenyek', 'szabalyzat', 'altalanos', 'bemutatkozas', 'szabadido', 'bevetes', 'jelentesek', 'logisztika']
        || isLeader()
        || (ch == 'u-mesterlovesz' && unitIs('mesterlovesz'))
        || (ch == 'u-taktikai' && unitIs('taktikai'))
        || (ch == 'u-ellatas' && unitIs('ellatas'))
      );
    }
    function canPost(ch) { return canSee(ch) && ch != 'szabalyzat' && (ch != 'kozlemenyek' || isLeader()); }
    function canVoice(room) { return isMember() && (room != 'v-vezetoi' || isLeader()); }

    // A Főbiztos kijelölése: csak egyszer hozható létre, utána nem módosítható.
    match /meta/owner {
      allow read: if true;
      allow create: if signedIn() && !ownerExists() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // A játékszerver-fiók azonosítója és belépési adatai: csak a Főbiztos látja
    match /meta/game {
      allow read, write: if isOwner();
    }
    match /secret/{doc} {
      allow read, write: if isOwner();
    }

    // Riasztási fokozat, közlemény, szabályzat, rangnevek
    match /config/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Csak az állomány látja (pl. a hangközvetítő szerver belépési adatai)
    match /private/{doc} {
      allow read: if isMember();
      allow write: if isOwner();
    }

    // Hivatalos Közlöny
    match /decrees/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Profilok: mindenki a sajátját írja
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.rpName is string
        && request.resource.data.rpName.size() <= 40;
      allow delete: if isOwner();
    }

    // Rendfokozat és egység: csak a Főbiztos állítja
    match /roles/{uid} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Felvételi kérelmek
    match /applications/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOwner());
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow update: if isOwner()
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'rejected' && request.resource.data.status == 'pending');
      allow delete: if isOwner();
    }

    // Szöveges csatornák
    match /channels/{ch}/messages/{id} {
      allow read: if canSee(ch);
      allow create: if canPost(ch)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.t is string
        && request.resource.data.t.size() <= 1500;
      allow update: if canSee(ch) && (
        (resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['t', 'e']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx'])
      );
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isOwner());
    }

    // Szolgálati napló: aktuális státusz (nyilvános létszámhoz) és lezárt szolgálatok
    match /duty/{uid} {
      allow read: if true;
      allow write: if (isMember() && request.auth.uid == uid) || isGame();
    }
    match /dutylog/{id} {
      allow read: if isMember();
      allow create: if (isMember() && request.resource.data.uid == request.auth.uid
          || isGame())
        && request.resource.data.mins is number && request.resource.data.mins <= 1440;
      allow delete: if isOwner();
    }

    // Jelentések
    match /reports/{id} {
      allow read: if isLeader() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if (isMember() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'submitted')
        || (isGame() && request.resource.data.status == 'submitted' && request.resource.data.src == 'roblox');
      allow update: if isLeader()
        || (signedIn() && resource.data.uid == request.auth.uid && resource.data.status == 'returned' && request.resource.data.status == 'submitted');
      allow delete: if isOwner();
    }

    // Parancsok: a vezetés adja ki, a tagok nyugtáznak
    match /orders/{id} {
      allow read: if isMember();
      allow create, delete: if isLeader();
      allow update: if isLeader() || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acks', 'done']));
    }

    // Eseménynaptár
    match /events/{id} {
      allow read: if isMember();
      allow create, delete: if isLeader();
      allow update: if isLeader() || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rsvp']));
    }

    // Személyi akta bejegyzései
    match /records/{id} {
      allow read: if isLeader() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isLeader() && request.resource.data.by == request.auth.uid;
      allow delete: if isOwner();
    }

    // Lakossági bejelentések: bárki beküldhet, csak a vezetés olvassa
    match /tips/{id} {
      allow create: if request.resource.data.keys().hasOnly(['cat', 'location', 'text', 'name', 'roblox', 'ref', 'at', 'status'])
        && request.resource.data.status == 'new'
        && request.resource.data.cat is string && request.resource.data.cat.size() <= 20
        && request.resource.data.location is string && request.resource.data.location.size() <= 120
        && request.resource.data.text is string && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 2000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.roblox is string && request.resource.data.roblox.size() <= 40
        && request.resource.data.ref is string && request.resource.data.ref.size() <= 40
        && request.resource.data.at is number;
      allow read, update: if isLeader();
      allow delete: if isOwner();
    }

    // Személy- és körözési nyilvántartás
    match /persons/{pid} {
      allow read: if isMember() || isGame() || resource.data.publicWanted == true;
      allow create: if (isGame() && request.resource.data.get('publicWanted', false) != true)
        || (isMember() && request.resource.data.createdBy == request.auth.uid
          && (request.resource.data.get('wanted', false) != true || atLeast(30))
          && (request.resource.data.get('publicWanted', false) != true || atLeast(50)));
      allow update: if (isGame() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicWanted']) || request.resource.data.publicWanted == false))
        || (isMember()
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['wanted', 'wlevel', 'wreason', 'wsince', 'wby']) || atLeast(30))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['publicWanted']) || atLeast(50)));
      allow delete: if isOwner();
      match /entries/{eid} {
        allow read: if isMember() || isGame();
        allow create: if isGame() || (isMember() && request.resource.data.by == request.auth.uid);
        allow delete: if isOwner();
      }
    }

    // Feltöltött képek (tömörítve): a tagok látják, a nyilvános körözések képei bárki
    match /images/{id} {
      allow read: if isMember() || resource.data.pub == true;
      allow create: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.d is string && request.resource.data.d.size() < 950000;
      allow update: if atLeast(50) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pub']);
      allow delete: if isOwner() || (signedIn() && resource.data.by == request.auth.uid);
    }

    // Roblox-fiók összekapcsolása: a tag kódot kér, a játék ellenőrzi és összeköti
    match /rbxcodes/{uid} {
      allow read: if isGame() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isMember() && request.auth.uid == uid
        && request.resource.data.code is string && request.resource.data.code.size() == 6
        && request.resource.data.name is string && request.resource.data.name.size() <= 20;
      allow delete: if isGame() || (signedIn() && request.auth.uid == uid);
    }
    match /rbxlinks/{rid} {
      allow read: if signedIn();
      allow create, update: if isGame();
      allow delete: if isGame() || isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Futó játékszerverek jelzései (létszám, szolgálatban lévők)
    match /gameservers/{id} {
      allow read: if true;
      allow write: if isGame();
      allow delete: if isGame() || isOwner();
    }

    // Online jelzés és "éppen ír…"
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Hangcsatornák: résztvevők és kapcsolatfelvételi jelzések
    match /voice/{room}/members/{uid} {
      allow read: if canVoice(room);
      allow create, update: if canVoice(room) && request.auth.uid == uid;
      allow delete: if signedIn() && (request.auth.uid == uid || isOwner());
    }
    match /voice/{room}/signals/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if canVoice(room) && request.resource.data.from == request.auth.uid;
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
  }
}
